# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_key_here

# Resend (email)
RESEND_API_KEY=re_your_key_here

# Admin dashboard password (orders + menu editor)
ADMIN_PASSWORD=choose_a_strong_password_here

# Owner email for order alerts
OWNER_EMAIL=your@email.com

# Menu editor, PRODUCTION ONLY (set in Vercel, not needed locally): a fine-grained GitHub token
# limited to this one repository with "Contents: Read and write". See MAINTENANCE.md.
GITHUB_TOKEN=github_pat_your_token_here
# Optional (defaults shown)
# GITHUB_REPO=sahash182/crunchandsteam
# GITHUB_BRANCH=main
